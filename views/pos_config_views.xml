<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The shop is normally built at install. This is the way back if that
         was skipped — typically because the chart of accounts was not set up
         yet, which leaves the scenario with no bank journal to attach a card
         payment method to. -->
    <record id="action_create_pressing_shop" model="ir.actions.server">
        <field name="name">Create the pressing shop</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="state">code</field>
        <field name="code">action = model.action_laundry_create_pressing_shop()</field>
    </record>

    <menuitem id="menu_create_pressing_shop"
              name="Create the pressing shop"
              parent="point_of_sale.menu_point_config_product"
              action="action_create_pressing_shop"
              groups="point_of_sale.group_pos_manager"
              sequence="95"/>
</odoo>
