<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_laundry" model="ir.ui.view">
        <field name="name">product.template.form.laundry</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='available_in_pos']" position="after">
                <field name="is_laundry_item"/>
                <field name="laundry_lead_days"
                       invisible="not is_laundry_item"/>
                <field name="laundry_emoji"
                       invisible="not is_laundry_item" placeholder="👔"/>
            </xpath>
        </field>
    </record>
</odoo>
